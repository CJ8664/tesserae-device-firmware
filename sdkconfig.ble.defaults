# BLE setup / maintenance for supported Seeed Refresh-button targets.
# Kept as an overlay so the native-USB EE02/EE04 builds can retain their
# USB-Serial-JTAG console base without enabling this feature for every XIAO
# board that shares sdkconfig.usbjtag.defaults.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# Wi-Fi and the BLE controller share internal RAM while setup runs (Companion
# scans and joins Wi-Fi over BLE), and the setup portal alone left a Sticky
# with ~5 KB internal free, so the controller's init malloc failed and the
# portal's Refresh hold fell straight back to the AP. Every BLE target is an
# ESP32-S3 with octal PSRAM, so let IDF place the Wi-Fi/BT/lwIP library BSS
# (and EXT_RAM_BSS_ATTR buffers) there, as the E1003 already does.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
